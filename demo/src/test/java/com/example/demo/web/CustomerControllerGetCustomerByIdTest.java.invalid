package com.example.demo.web;
import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.List;

@ExtendWith(MockitoExtension.class)
class CustomerControllerGetCustomerByIdTest {
    @Mock
    private CustomerService customerService;
    private CustomerController customerController;
    @BeforeEach
    void setUp() {
        customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("invalid")
    void getCustomerByIdReturnsEmptyOptionalWhenCustomerNotFound() {
        // Arrange
        Long nonExistentId = 999L;
        when(customerService.getCustomerById(nonExistentId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(nonExistentId);
        // Assert
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(nonExistentId);
    }
    @Test
    @Tag("invalid")
    void getCustomerByIdWithNullIdParameter() {
        // Arrange
        when(customerService.getCustomerById(null)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(null);
        // Assert
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(null);
    }
    @Test
    @Tag("boundary")
    void getCustomerByIdWithZeroId() {
        // Arrange
        Long zeroId = 0L;
        when(customerService.getCustomerById(zeroId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(zeroId);
        // Assert
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(zeroId);
    }
    @Test
    @Tag("boundary")
    void getCustomerByIdWithNegativeId() {
        // Arrange
        Long negativeId = -1L;
        when(customerService.getCustomerById(negativeId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(negativeId);
        // Assert
        assertTrue(result.isEmpty());
        verify(customerService, times(1)).getCustomerById(negativeId);
    }
    @Test
    @Tag("boundary")
    void getCustomerByIdWithMaxLongValue() {
        // Arrange
        Long maxId = Long.MAX_VALUE;
        when(customerService.getCustomerById(maxId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerController.getCustomerById(maxId);
        // Assert
        assertTrue(result.isEmpty());
        assertDoesNotThrow(() -> customerController.getCustomerById(maxId));
        verify(customerService, times(2)).getCustomerById(maxId);
    }
    @Test
    @Tag("valid")
    void getCustomerByIdDelegatesCorrectlyToService() {
        // Arrange
        Long customerId = 42L;
        when(customerService.getCustomerById(customerId)).thenReturn(Optional.empty());
        // Act
        customerController.getCustomerById(customerId);
        // Assert
        verify(customerService, times(1)).getCustomerById(customerId);
    }
    @Test
    @Tag("valid")
    void getCustomerByIdReturnsCustomerWhenFound() {
        // Arrange
        Long customerId = 1L;
        Customer expectedCustomer = new Customer();
        when(customerService.getCustomerById(customerId)).thenReturn(Optional.of(expectedCustomer));
        // Act
        Optional<Customer> result = customerController.getCustomerById(customerId);
        // Assert
        assertTrue(result.isPresent());
        assertNotNull(result.get());
        assertEquals(expectedCustomer, result.get());
        verify(customerService, times(1)).getCustomerById(customerId);
    }
}