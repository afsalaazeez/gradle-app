package com.example.demo.web;
import com.example.demo.domain.Customer;
import com.example.demo.service.CustomerService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.web.bind.annotation.*;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerControllerGetAllCustomersTest {
    @Mock
    private CustomerService customerService;
    private CustomerController customerController;
    @BeforeEach
    void setUp() {
        customerController = new CustomerController(customerService);
    }
    @Test
    @Tag("valid")
    void getAllCustomersReturnsMultipleCustomers() {
        // Arrange
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        Customer customer3 = new Customer();
        List<Customer> expectedCustomers = Arrays.asList(customer1, customer2, customer3);
        
        when(customerService.getAllCustomers()).thenReturn(expectedCustomers);
        // Act
        List<Customer> actualCustomers = customerController.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers);
        assertEquals(3, actualCustomers.size());
        assertTrue(actualCustomers.contains(customer1));
        assertTrue(actualCustomers.contains(customer2));
        assertTrue(actualCustomers.contains(customer3));
    }
    @Test
    @Tag("boundary")
    void getAllCustomersReturnsEmptyListWhenNoCustomers() {
        // Arrange
        List<Customer> emptyList = Collections.emptyList();
        when(customerService.getAllCustomers()).thenReturn(emptyList);
        // Act
        List<Customer> actualCustomers = customerController.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers);
        assertEquals(0, actualCustomers.size());
        assertTrue(actualCustomers.isEmpty());
    }
    @Test
    @Tag("valid")
    void getAllCustomersCallsServiceMethodOnce() {
        // Arrange
        List<Customer> customerList = new ArrayList<>();
        when(customerService.getAllCustomers()).thenReturn(customerList);
        // Act
        customerController.getAllCustomers();
        // Assert
        verify(customerService, times(1)).getAllCustomers();
    }
    @Test
    @Tag("boundary")
    void getAllCustomersReturnsSingleCustomer() {
        // Arrange
        Customer singleCustomer = new Customer();
        List<Customer> singleCustomerList = Collections.singletonList(singleCustomer);
        
        when(customerService.getAllCustomers()).thenReturn(singleCustomerList);
        // Act
        List<Customer> actualCustomers = customerController.getAllCustomers();
        // Assert
        assertNotNull(actualCustomers);
        assertEquals(1, actualCustomers.size());
        assertEquals(singleCustomer, actualCustomers.get(0));
    }
    @Test
    @Tag("valid")
    void getAllCustomersReturnsSameListFromService() {
        // Arrange
        List<Customer> expectedList = new ArrayList<>();
        expectedList.add(new Customer());
        expectedList.add(new Customer());
        
        when(customerService.getAllCustomers()).thenReturn(expectedList);
        // Act
        List<Customer> actualList = customerController.getAllCustomers();
        // Assert
        assertSame(expectedList, actualList);
    }
    @Test
    @Tag("invalid")
    void getAllCustomersThrowsExceptionWhenServiceFails() {
        // Arrange
        String errorMessage = "Database connection failed";
        when(customerService.getAllCustomers()).thenThrow(new RuntimeException(errorMessage));
        // Act & Assert
        RuntimeException exception = assertThrows(RuntimeException.class, () -> {
            customerController.getAllCustomers();
        });
        
        assertEquals(errorMessage, exception.getMessage());
    }
}