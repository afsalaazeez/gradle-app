package com.example.demo.service;
import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;

@ExtendWith(MockitoExtension.class)
class CustomerServiceGetCustomerByIdTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    @BeforeEach
    void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    void getCustomerByIdReturnsCustomerWhenIdExists() {
        // Arrange
        Long customerId = 1L;
        Customer expectedCustomer = new Customer();
        when(customerRepository.findById(customerId)).thenReturn(Optional.of(expectedCustomer));
        // Act
        Optional<Customer> result = customerService.getCustomerById(customerId);
        // Assert
        assertTrue(result.isPresent());
        assertEquals(expectedCustomer, result.get());
        verify(customerRepository, times(1)).findById(customerId);
    }
    @Test
    @Tag("valid")
    void getCustomerByIdReturnsEmptyOptionalWhenIdDoesNotExist() {
        // Arrange
        Long nonExistingId = 999L;
        when(customerRepository.findById(nonExistingId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerService.getCustomerById(nonExistingId);
        // Assert
        assertFalse(result.isPresent());
        verify(customerRepository, times(1)).findById(nonExistingId);
    }
    @Test
    @Tag("invalid")
    void getCustomerByIdWithNullId() {
        // Arrange
        when(customerRepository.findById(null)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerService.getCustomerById(null);
        // Assert
        assertFalse(result.isPresent());
        verify(customerRepository, times(1)).findById(null);
    }
    @Test
    @Tag("boundary")
    void getCustomerByIdWithZeroId() {
        // Arrange
        Long zeroId = 0L;
        when(customerRepository.findById(zeroId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerService.getCustomerById(zeroId);
        // Assert
        assertFalse(result.isPresent());
        verify(customerRepository, times(1)).findById(zeroId);
    }
    @Test
    @Tag("invalid")
    void getCustomerByIdWithNegativeId() {
        // Arrange
        Long negativeId = -1L;
        when(customerRepository.findById(negativeId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerService.getCustomerById(negativeId);
        // Assert
        assertFalse(result.isPresent());
        verify(customerRepository, times(1)).findById(negativeId);
    }
    @Test
    @Tag("boundary")
    void getCustomerByIdWithMaxLongValue() {
        // Arrange
        Long maxLongId = Long.MAX_VALUE;
        when(customerRepository.findById(maxLongId)).thenReturn(Optional.empty());
        // Act
        Optional<Customer> result = customerService.getCustomerById(maxLongId);
        // Assert
        assertFalse(result.isPresent());
        verify(customerRepository, times(1)).findById(maxLongId);
    }
    @Test
    @Tag("integration")
    void getCustomerByIdCallsRepositoryWithCorrectId() {
        // Arrange
        Long specificId = 42L;
        when(customerRepository.findById(specificId)).thenReturn(Optional.empty());
        // Act
        customerService.getCustomerById(specificId);
        // Assert
        verify(customerRepository, times(1)).findById(specificId);
        verifyNoMoreInteractions(customerRepository);
    }
}