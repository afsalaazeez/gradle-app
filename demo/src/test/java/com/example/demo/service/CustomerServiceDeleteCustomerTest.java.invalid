package com.example.demo.service;
import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.junit.jupiter.api.Assertions.assertDoesNotThrow;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerServiceDeleteCustomerTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    @BeforeEach
    void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    void deleteCustomerWithValidId() {
        // Arrange
        Long validId = 1L;
        doNothing().when(customerRepository).deleteById(validId);
        // Act
        customerService.deleteCustomer(validId);
        // Assert
        verify(customerRepository, times(1)).deleteById(validId);
    }
    @Test
    @Tag("invalid")
    void deleteCustomerWithNullId() {
        // Arrange
        Long nullId = null;
        doNothing().when(customerRepository).deleteById(nullId);
        // Act
        customerService.deleteCustomer(nullId);
        // Assert
        verify(customerRepository, times(1)).deleteById(nullId);
    }
    @Test
    @Tag("valid")
    void deleteCustomerWithNonExistentId() {
        // Arrange
        Long nonExistentId = 999L;
        doNothing().when(customerRepository).deleteById(nonExistentId);
        // Act
        customerService.deleteCustomer(nonExistentId);
        // Assert
        verify(customerRepository, times(1)).deleteById(nonExistentId);
    }
    @Test
    @Tag("boundary")
    void deleteCustomerWithZeroId() {
        // Arrange
        Long zeroId = 0L;
        doNothing().when(customerRepository).deleteById(zeroId);
        // Act
        customerService.deleteCustomer(zeroId);
        // Assert
        verify(customerRepository, times(1)).deleteById(zeroId);
    }
    @Test
    @Tag("boundary")
    void deleteCustomerWithNegativeId() {
        // Arrange
        Long negativeId = -1L;
        doNothing().when(customerRepository).deleteById(negativeId);
        // Act
        customerService.deleteCustomer(negativeId);
        // Assert
        verify(customerRepository, times(1)).deleteById(negativeId);
    }
    @Test
    @Tag("boundary")
    void deleteCustomerWithMaxLongValue() {
        // Arrange
        Long maxLongId = Long.MAX_VALUE;
        doNothing().when(customerRepository).deleteById(maxLongId);
        // Act
        customerService.deleteCustomer(maxLongId);
        // Assert
        verify(customerRepository, times(1)).deleteById(maxLongId);
    }
    @Test
    @Tag("invalid")
    void deleteCustomerWhenRepositoryThrowsException() {
        // Arrange
        Long id = 1L;
        doThrow(new RuntimeException("Database error")).when(customerRepository).deleteById(id);
        // Act & Assert
        assertThrows(RuntimeException.class, () -> customerService.deleteCustomer(id));
        verify(customerRepository, times(1)).deleteById(id);
    }
}