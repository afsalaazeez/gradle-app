package com.example.demo.service;
import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerServiceGetAllCustomersTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    @BeforeEach
    void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    void getAllCustomersReturnsEmptyListWhenNoCustomersExist() {
        // Arrange
        when(customerRepository.findAll()).thenReturn(new ArrayList<>());
        // Act
        List<Customer> result = customerService.getAllCustomers();
        // Assert
        assertNotNull(result);
        assertTrue(result.isEmpty());
        assertEquals(0, result.size());
    }
    @Test
    @Tag("valid")
    void getAllCustomersReturnsMultipleCustomersSuccessfully() {
        // Arrange
        Customer customer1 = new Customer();
        Customer customer2 = new Customer();
        Customer customer3 = new Customer();
        List<Customer> expectedCustomers = Arrays.asList(customer1, customer2, customer3);
        when(customerRepository.findAll()).thenReturn(expectedCustomers);
        // Act
        List<Customer> result = customerService.getAllCustomers();
        // Assert
        assertNotNull(result);
        assertEquals(3, result.size());
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("valid")
    void getAllCustomersCallsRepositoryFindAllOnce() {
        // Arrange
        when(customerRepository.findAll()).thenReturn(new ArrayList<>());
        // Act
        customerService.getAllCustomers();
        // Assert
        verify(customerRepository, times(1)).findAll();
    }
    @Test
    @Tag("boundary")
    void getAllCustomersHandlesNullReturnFromRepository() {
        // Arrange
        when(customerRepository.findAll()).thenReturn(null);
        // Act
        List<Customer> result = customerService.getAllCustomers();
        // Assert
        assertNull(result);
    }
    @Test
    @Tag("valid")
    void getAllCustomersPreservesCustomerNameAndEmail() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("John");
        customer.setEmail("john@example.com");
        List<Customer> expectedCustomers = Arrays.asList(customer);
        when(customerRepository.findAll()).thenReturn(expectedCustomers);
        // Act
        List<Customer> result = customerService.getAllCustomers();
        // Assert
        assertNotNull(result);
        assertFalse(result.isEmpty());
        assertEquals("John", result.get(0).getName());
        assertEquals("john@example.com", result.get(0).getEmail());
    }
}