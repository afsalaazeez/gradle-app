package com.example.demo.service;import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerServiceCreateCustomerTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    
    @BeforeEach
    void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    
    @Test
    @Tag("valid")
    void createCustomerWithValidDataReturnsPersistedCustomer() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("John Doe");
        customer.setEmail("john.doe@example.com");
        
        when(customerRepository.save(customer)).thenReturn(customer);
        // Act
        Customer result = customerService.createCustomer(customer);
        // Assert
        assertNotNull(result);
        assertEquals(customer, result);
        assertEquals("John Doe", result.getName());
        assertEquals("john.doe@example.com", result.getEmail());
    }
    
    @Test
    @Tag("invalid")
    void createCustomerWithNullCustomerDelegatesToRepository() {
        // Arrange
        when(customerRepository.save(null)).thenReturn(null);
        // Act
        Customer result = customerService.createCustomer(null);
        // Assert
        assertNull(result);
        verify(customerRepository).save(null);
    }
    
    @Test
    @Tag("invalid")
    void createCustomerWhenRepositoryThrowsExceptionPropagatesException() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("Jane Doe");
        customer.setEmail("jane.doe@example.com");
        
        when(customerRepository.save(customer)).thenThrow(new RuntimeException("Database error"));
        // Act & Assert
        RuntimeException exception = assertThrows(RuntimeException.class, () -> {
            customerService.createCustomer(customer);
        });
        
        assertEquals("Database error", exception.getMessage());
    }
    
    @Test
    @Tag("boundary")
    void createCustomerWithEmptyFieldsDelegatesToRepository() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("");
        customer.setEmail("");
        
        when(customerRepository.save(customer)).thenReturn(customer);
        // Act
        Customer result = customerService.createCustomer(customer);
        // Assert
        assertNotNull(result);
        assertEquals(customer, result);
        assertEquals("", result.getName());
        assertEquals("", result.getEmail());
    }
    
    @Test
    @Tag("valid")
    void createCustomerCallsRepositorySaveExactlyOnce() {
        // Arrange
        Customer customer = new Customer();
        customer.setName("Test User");
        customer.setEmail("test@example.com");
        
        when(customerRepository.save(customer)).thenReturn(customer);
        // Act
        customerService.createCustomer(customer);
        // Assert
        verify(customerRepository, times(1)).save(customer);
        verifyNoMoreInteractions(customerRepository);
    }
    
    @Test
    @Tag("valid")
    void createCustomerReturnsExactRepositoryResponse() {
        // Arrange
        Customer inputCustomer = new Customer();
        inputCustomer.setName("Input User");
        inputCustomer.setEmail("input@example.com");
        
        // Note: The Customer class does not have a setId() method.
        // If the ID needs to be set, consider adding a setId() method to the Customer class
        // or using a constructor that accepts an ID parameter.
        Customer savedCustomer = new Customer();
        savedCustomer.setName("Input User");
        savedCustomer.setEmail("input@example.com");
        
        when(customerRepository.save(inputCustomer)).thenReturn(savedCustomer);
        // Act
        Customer result = customerService.createCustomer(inputCustomer);
        // Assert
        assertNotNull(result);
        assertSame(savedCustomer, result);
        assertNotSame(inputCustomer, result);
        // Removed assertion for ID since setId() method doesn't exist in Customer class
        assertEquals("Input User", result.getName());
        assertEquals("input@example.com", result.getEmail());
    }
}