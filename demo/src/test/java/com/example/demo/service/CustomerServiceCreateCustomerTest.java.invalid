package com.example.demo.service;
import com.example.demo.domain.Customer;
import com.example.demo.domain.CustomerRepository;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;
import org.junit.jupiter.api.*;
import org.springframework.stereotype.Service;
import java.util.List;
import java.util.Optional;

@ExtendWith(MockitoExtension.class)
class CustomerServiceCreateCustomerTest {
    @Mock
    private CustomerRepository customerRepository;
    private CustomerService customerService;
    @BeforeEach
    void setUp() {
        customerService = new CustomerService(customerRepository);
    }
    @Test
    @Tag("valid")
    void createCustomerWithValidData() {
        // Arrange
        Customer customer = new Customer();
        when(customerRepository.save(customer)).thenReturn(customer);
        // Act
        Customer result = customerService.createCustomer(customer);
        // Assert
        assertNotNull(result);
        assertEquals(customer, result);
    }
    @Test
    @Tag("invalid")
    void createCustomerWithNullInput() {
        // Arrange
        when(customerRepository.save(null)).thenReturn(null);
        // Act
        Customer result = customerService.createCustomer(null);
        // Assert
        assertNull(result);
    }
    @Test
    @Tag("valid")
    void createCustomerCallsRepositorySave() {
        // Arrange
        Customer customer = new Customer();
        when(customerRepository.save(customer)).thenReturn(customer);
        // Act
        customerService.createCustomer(customer);
        // Assert
        verify(customerRepository, times(1)).save(customer);
    }
    @Test
    @Tag("valid")
    void createCustomerReturnsRepositoryResponse() {
        // Arrange
        Customer inputCustomer = new Customer();
        Customer expectedCustomer = new Customer();
        when(customerRepository.save(inputCustomer)).thenReturn(expectedCustomer);
        // Act
        Customer result = customerService.createCustomer(inputCustomer);
        // Assert
        assertSame(expectedCustomer, result);
    }
    @Test
    @Tag("invalid")
    void createCustomerWhenRepositoryThrowsException() {
        // Arrange
        Customer customer = new Customer();
        when(customerRepository.save(customer)).thenThrow(new RuntimeException("Database error"));
        // Act & Assert
        assertThrows(RuntimeException.class, () -> customerService.createCustomer(customer));
    }
    @Test
    @Tag("boundary")
    void createCustomerWithEmptyCustomerObject() {
        // Arrange
        Customer emptyCustomer = new Customer();
        when(customerRepository.save(emptyCustomer)).thenReturn(emptyCustomer);
        // Act
        Customer result = customerService.createCustomer(emptyCustomer);
        // Assert
        assertNotNull(result);
        assertEquals(emptyCustomer, result);
    }
}