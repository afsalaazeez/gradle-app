package org.example.list;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Assertions;
import org.junit.jupiter.api.*;

public class LinkedListGetTest {
    @Test
    @Tag("valid")
    public void testGetValueAtIndexZeroSingleElementList() {
        LinkedList list = new LinkedList();
        list.add("A");
        Assertions.assertEquals((String) "A", (String) list.get(0));
    }
    @Test
    @Tag("valid")
    public void testGetValueAtIndexZeroMultipleElementList() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
        Assertions.assertEquals((String) "A", (String) list.get(0));
    }
    @Test
    @Tag("valid")
    public void testGetValueAtMiddleIndex() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
        Assertions.assertEquals((String) "B", (String) list.get(1));
    }
    @Test
    @Tag("valid")
    public void testGetValueAtLastIndex() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
        Assertions.assertEquals((String) "C", (String) list.get(2));
    }
    @Test
    @Tag("invalid")
    public void testGetValueAtIndexOutOfRange() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            list.get(3);
        });
    }
    @Test
    @Tag("invalid")
    public void testGetValueAtNegativeIndex() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        // Comment: The current get(int index) method does NOT handle negative index. 
        // Enhancement needed in business logic for explicit negative index handling.
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            list.get(-1);
        });
    }
    @Test
    @Tag("invalid")
    public void testGetValueFromEmptyList() {
        LinkedList list = new LinkedList();
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            list.get(0);
        });
    }
    @Test
    @Tag("boundary")
    public void testGetValueAtIndexEqualToSize() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        // Comment: Assuming LinkedList has a valid size() method.
        // The get(int index) method does not handle index == size, expect exception.
        int size = 2;
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            list.get(size); // size == 2, valid indices: 0,1
        });
    }
    @Test
    @Tag("integration")
    public void testGetValueAfterNodeRemoval() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.remove("A");
        Assertions.assertEquals((String) "B", (String) list.get(0));
    }
    @Test
    @Tag("invalid")
    public void testGetRemovedElementCausesException() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.remove("B");
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            list.get(1);
        });
    }
    @Test
    @Tag("integration")
    public void testGetConsecutiveElementsOrder() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
        Assertions.assertEquals((String) "A", (String) list.get(0));
        Assertions.assertEquals((String) "B", (String) list.get(1));
        Assertions.assertEquals((String) "C", (String) list.get(2));
    }
}