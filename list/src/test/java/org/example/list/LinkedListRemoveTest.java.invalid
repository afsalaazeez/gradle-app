package org.example.list;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Assertions;
import org.junit.jupiter.api.*;

public class LinkedListRemoveTest {
    // Scenario 1: Remove an Existing Element from the List
    @Test
    @Tag("valid")
    public void testRemoveExistingElementFromList() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
        int originalSize = (int) list.size();
        boolean result = (boolean) list.remove("B");
        Assertions.assertTrue((boolean)result);
        Assertions.assertEquals((int) (originalSize - 1), (int) list.size());
        // Confirm "B" no longer in list
        boolean found = false;
        for (int i = 0; i < (int)list.size(); i++) {
            if (((String) list.get(i)).equals("B")) {
                found = true;
                break;
            }
        }
        Assertions.assertFalse((boolean) found);
    }
    // Scenario 2: Attempt to Remove an Element That Does Not Exist
    @Test
    @Tag("invalid")
    public void testRemoveNonExistentElementFromList() {
        LinkedList list = new LinkedList();
        list.add("X");
        list.add("Y");
        list.add("Z");
        int originalSize = (int) list.size();
        boolean result = (boolean) list.remove("W");
        Assertions.assertFalse((boolean)result);
        Assertions.assertEquals((int)originalSize, (int)list.size());
    }
    // Scenario 3: Remove the First Element (Head) of the List
    @Test
    @Tag("boundary")
    public void testRemoveHeadElementFromList() {
        LinkedList list = new LinkedList();
        list.add("First");
        list.add("Middle");
        list.add("Last");
        boolean result = (boolean) list.remove("First");
        Assertions.assertTrue((boolean)result);
        Assertions.assertEquals((String)"Middle", (String)list.get(0));
        Assertions.assertFalse((boolean)"First".equals((String)list.get(0)));
        int expectedSize = 2;
        Assertions.assertEquals((int)expectedSize, (int)list.size());
    }
    // Scenario 4: Remove the Last Element of the List
    @Test
    @Tag("boundary")
    public void testRemoveTailElementFromList() {
        LinkedList list = new LinkedList();
        list.add("E1");
        list.add("E2");
        list.add("E3");
        int originalSize = (int) list.size();
        boolean result = (boolean) list.remove("E3");
        Assertions.assertTrue((boolean)result);
        Assertions.assertEquals((int)(originalSize - 1), (int)list.size());
        // Last node should now be "E2"
        Assertions.assertEquals((String)"E2", (String)list.get(list.size() - 1));
    }
    // Scenario 5: Remove Element from Middle of List
    @Test
    @Tag("valid")
    public void testRemoveMiddleElementFromList() {
        LinkedList list = new LinkedList();
        list.add("Alpha");
        list.add("Beta");
        list.add("Gamma");
        int originalSize = (int) list.size();
        boolean result = (boolean) list.remove("Beta");
        Assertions.assertTrue((boolean)result);
        Assertions.assertEquals((int)(originalSize - 1), (int)list.size());
        // The order should skip "Beta"
        Assertions.assertEquals((String)"Gamma", (String)list.get(1));
    }
    // Scenario 6: Attempt Removal from an Empty List
    @Test
    @Tag("boundary")
    public void testRemoveElementFromEmptyList() {
        LinkedList list = new LinkedList();
        boolean result = (boolean) list.remove("Sample");
        Assertions.assertFalse((boolean)result);
        Assertions.assertEquals((int)0, (int)list.size());
    }
    // Scenario 7: Remove Element When List Contains Duplicates
    @Test
    @Tag("integration")
    public void testRemoveFirstDuplicateElementFromList() {
        LinkedList list = new LinkedList();
        list.add("Dup");
        list.add("X");
        list.add("Dup");
        list.add("Y");
        int originalSize = (int) list.size();
        boolean result = (boolean) list.remove("Dup");
        Assertions.assertTrue((boolean)result);
        Assertions.assertEquals((int)(originalSize - 1), (int)list.size());
        // Only one "Dup" should remain; first should not be "Dup" anymore
        int dupCount = 0;
        for (int i = 0; i < (int)list.size(); i++) {
            if (((String) list.get(i)).equals("Dup")) {
                dupCount++;
            }
        }
        Assertions.assertEquals((int)1, (int)dupCount); // Only the second "Dup" remains
        Assertions.assertFalse((boolean)"Dup".equals((String)list.get(0))); // Head should not be "Dup" anymore
    }
    // Scenario 8: Attempt Removal with Null Input
    @Test
    @Tag("invalid")
    public void testRemoveNullElementFromList() {
        // If your business logic does not handle 'null', suggest to add a null check
        // and return false or throw NullPointerException as per design.
        // Current implementation can throw NullPointerException on compareTo(null).
        // ==> Suggestion: Add if (element == null) throw new NullPointerException();
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        try {
            boolean result = (boolean) list.remove(null);
            Assertions.assertFalse((boolean)result);
        } catch (NullPointerException ex) {
            // Valid outcome if method contract is to throw
            Assertions.assertTrue((ex instanceof NullPointerException));
        }
        Assertions.assertEquals((int)2, (int)list.size());
    }
    // Scenario 9: Remove Element When List Contains Only One Node
    @Test
    @Tag("boundary")
    public void testRemoveSingleElementFromSingleNodeList() {
        LinkedList list = new LinkedList();
        list.add("Solo");
        boolean result = (boolean) list.remove("Solo");
        Assertions.assertTrue((boolean)result);
        Assertions.assertEquals((int)0, (int)list.size());
        // Further operations will raise IndexOutOfBounds
        Assertions.assertThrows(IndexOutOfBoundsException.class, () -> {
            list.get(0);
        });
    }
    // Scenario 10: Remove Element with Similar But Not Equal Value
    @Test
    @Tag("invalid")
    public void testRemoveElementWithSimilarValueFromList() {
        LinkedList list = new LinkedList();
        list.add("apple");
        list.add("applesauce");
        list.add("appl");
        int originalSize = (int) list.size();
        boolean result = (boolean) list.remove("appel"); // "appel" is similar but not equal
        Assertions.assertFalse((boolean)result);
        Assertions.assertEquals((int)originalSize, (int)list.size());
        // All original elements should remain
        Assertions.assertEquals((String)"appl", (String)list.get(2));
    }
