package org.example.list;
import org.junit.jupiter.api.*;
import static org.junit.jupiter.api.Assertions.*;
import org.example.list.LinkedList;

class LinkedListRemoveTest {
    private LinkedList list;
    @BeforeEach
    public void setUp() {
        list = new LinkedList();
    }
    @Test
    @Tag("boundary")
    public void testRemoveElementAtHead() {
        list.add("A");
        boolean removed = (boolean)list.remove("A");
        assertTrue((boolean) removed);
        assertEquals((int)0, (int)list.size());
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(0));
    }
    @Test
    @Tag("boundary")
    public void testRemoveElementAtTail() {
        list.add("A");
        list.add("B");
        list.add("C");
        boolean removed = (boolean)list.remove("C");
        assertTrue((boolean) removed);
        assertEquals((int)2, (int)list.size());
        assertEquals((String)"A", (String)list.get(0));
        assertEquals((String)"B", (String)list.get(1));
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(2));
    }
    @Test
    @Tag("valid")
    public void testRemoveElementInMiddle() {
        list.add("A");
        list.add("B");
        list.add("C");
        boolean removed = (boolean)list.remove("B");
        assertTrue((boolean) removed);
        assertEquals((int)2, (int)list.size());
        assertEquals((String)"A", (String)list.get(0));
        assertEquals((String)"C", (String)list.get(1));
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(2));
    }
    @Test
    @Tag("invalid")
    public void testRemoveNonExistingElement() {
        list.add("A");
        list.add("B");
        boolean removed = (boolean)list.remove("C");
        assertFalse((boolean) removed);
        assertEquals((int)2, (int)list.size());
        assertEquals((String)"A", (String)list.get(0));
        assertEquals((String)"B", (String)list.get(1));
    }
    @Test
    @Tag("invalid")
    public void testRemoveFromEmptyList() {
        boolean removed = (boolean)list.remove("A");
        assertFalse((boolean) removed);
        assertEquals((int)0, (int)list.size());
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(0));
    }
    @Test
    @Tag("valid")
    public void testRemoveFirstDuplicateElement() {
        list.add("A");
        list.add("B");
        list.add("B");
        list.add("C");
        boolean removed = (boolean)list.remove("B");
        assertTrue((boolean) removed);
        assertEquals((int)3, (int)list.size());
        assertEquals((String)"A", (String)list.get(0));
        assertEquals((String)"B", (String)list.get(1));
        assertEquals((String)"C", (String)list.get(2));
    }
    @Test
    @Tag("integration")
    public void testRemoveElementsUntilEmpty() {
        list.add("A");
        list.add("B");
        list.add("C");
        assertTrue((boolean)list.remove("A"));
        assertEquals((int)2, (int)list.size());
        assertTrue((boolean)list.remove("B"));
        assertEquals((int)1, (int)list.size());
        assertTrue((boolean)list.remove("C"));
        assertEquals((int)0, (int)list.size());
        assertThrows(IndexOutOfBoundsException.class, () -> list.get(0));
    }
    @Test
    @Tag("valid")
    public void testRemoveElementCaseSensitive() {
        list.add("A");
        list.add("a");
        boolean removed = (boolean)list.remove("a");
        assertTrue((boolean) removed);
        assertEquals((int)1, (int)list.size());
        assertEquals((String)"A", (String)list.get(0));
    }
    @Test
    @Tag("invalid")
    public void testRemoveNullElement() {
        list.add("A");
        // Suggestion for business logic: .remove(null) should defensively throw NullPointerException (current logic assumes element is non-null - otherwise causes NullPointerException at compareTo). This test expects that behavior. If you want a no-op, check for null at the top of remove().
        assertThrows(NullPointerException.class, () -> list.remove(null));
        assertEquals((int)1, (int)list.size());
        assertEquals((String)"A", (String)list.get(0));
    }
    @Test
    @Tag("valid")
    public void testRemoveFromListOfDuplicates() {
        list.add("B");
        list.add("B");
        list.add("B");
        boolean removed = (boolean)list.remove("B");
        assertTrue((boolean) removed);
        assertEquals((int)2, (int)list.size());
        assertEquals((String)"B", (String)list.get(0));
        assertEquals((String)"B", (String)list.get(1));
    }
}