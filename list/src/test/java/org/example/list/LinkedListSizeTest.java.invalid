package org.example.list;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.example.list.LinkedList;
import org.junit.jupiter.api.*;

public class LinkedListSizeTest {
    // Helper class to simulate Node embedded class
    // Commented out since Node is not needed for these black-box tests.
    // private static class Node {
    //     String data;
    //     Node next;
    //     Node(String data) {
    //         this.data = data;
    //         this.next = null;
    //     }
    // }
    // Scenario 1: Check the size of an empty LinkedList
    @Test
    @Tag("boundary")
    public void testSizeReturnsZeroWhenListIsEmpty() {
        LinkedList list = new LinkedList();
        assertEquals((int) 0, (int) list.size());
    }
    // Scenario 2: Verify size after adding one element
    @Test
    @Tag("valid")
    public void testSizeReturnsOneAfterSingleAdd() {
        LinkedList list = new LinkedList();
        list.add("foo");
        assertEquals((int) 1, (int) list.size());
    }
    // Scenario 3: Verify size after adding multiple elements
    @Test
    @Tag("valid")
    public void testSizeReflectsMultipleAdds() {
        LinkedList list = new LinkedList();
        list.add("a");
        list.add("b");
        list.add("c");
        assertEquals((int) 3, (int) list.size());
    }
    // Scenario 4: Size after removing one element from a multi-element list
    @Test
    @Tag("valid")
    public void testSizeUpdatesAfterSingleRemove() {
        LinkedList list = new LinkedList();
        list.add("a");
        list.add("b");
        list.add("c");
        list.remove("b");
        assertEquals((int) 2, (int) list.size());
    }
    // Scenario 5: Size after removing all elements from the list
    @Test
    @Tag("valid")
    public void testSizeReturnsZeroAfterAllRemoved() {
        LinkedList list = new LinkedList();
        list.add("x");
        list.add("y");
        list.remove("x");
        list.remove("y");
        assertEquals((int) 0, (int) list.size());
    }
    // Scenario 6: Size remains constant after removing a non-existent element
    @Test
    @Tag("invalid")
    public void testSizeUnchangedWhenNonExistentElementRemoved() {
        LinkedList list = new LinkedList();
        list.add("foo");
        list.add("bar");
        list.remove("baz"); // "baz" does not exist
        assertEquals((int) 2, (int) list.size());
    }
    // Scenario 7: Size after adding duplicate elements
    @Test
    @Tag("valid")
    public void testSizeCountsDuplicatesIndependently() {
        LinkedList list = new LinkedList();
        list.add("x");
        list.add("x");
        list.add("x");
        assertEquals((int) 3, (int) list.size());
    }
    // Scenario 8: Size after alternating adds and removes
    @Test
    @Tag("integration")
    public void testSizeReflectsInterleavedAddAndRemove() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("two");
        list.remove("one");
        list.add("three");
        assertEquals((int) 2, (int) list.size());
    }
    // Scenario 9: Size is unaffected by removing from an empty list
    @Test
    @Tag("boundary")
    public void testSizeStaysZeroWhenRemovingFromEmpty() {
        LinkedList list = new LinkedList();
        list.remove("ghost");
        assertEquals((int) 0, (int) list.size());
    }
    // Scenario 10: Confirm size when only head node is present
    @Test
    @Tag("boundary")
    public void testSizeIsOneWhenOnlyHead() {
        LinkedList list = new LinkedList();
        list.add("single");
        assertEquals((int) 1, (int) list.size());
    }
    // Scenario 11: Confirm size correctness after adding and removing head
    @Test
    @Tag("valid")
    public void testSizeReflectsRemovalOfHeadElement() {
        LinkedList list = new LinkedList();
        list.add("x");
        list.add("y");
        list.remove("x");
        assertEquals((int) 1, (int) list.size());
    }
    // Scenario 12: Confirm size when removing the tail element
    @Test
    @Tag("valid")
    public void testSizeReflectsRemovalOfTailElement() {
        LinkedList list = new LinkedList();
        list.add("v");
        list.add("w");
        list.add("z");
        list.remove("z");
        assertEquals((int) 2, (int) list.size());
    }
    // Scenario 13: Confirm size on large lists
    @Test
    @Tag("integration")
    public void testSizeHandlesLargeNumberOfElements() {
        LinkedList list = new LinkedList();
        int count = 1000; // You can change this value if needed
        for (int i = 0; i < count; i++) {
            list.add("element" + i);
        }
        assertEquals((int) count, (int) list.size());
    }
}