package org.example.list;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.assertEquals;
import org.junit.jupiter.api.*;

public class LinkedListSizeTest {
    @Test
    @Tag("valid")
    public void testSizeReturnsZeroForEmptyList() {
        LinkedList list = new LinkedList();
        assertEquals(0, (int) list.size());
    }
    @Test
    @Tag("valid")
    public void testSizeReturnsOneAfterAddingOneElement() {
        LinkedList list = new LinkedList();
        list.add("alpha");
        assertEquals(1, (int) list.size());
    }
    @Test
    @Tag("valid")
    public void testSizeReturnsCorrectCountForMultipleElements() {
        LinkedList list = new LinkedList();
        list.add("a");
        list.add("b");
        list.add("c");
        assertEquals(3, (int) list.size());
    }
    @Test
    @Tag("valid")
    public void testSizeDecreasesAfterRemovingElement() {
        LinkedList list = new LinkedList();
        list.add("x");
        list.add("y");
        list.remove("x");
        assertEquals(1, (int) list.size());
    }
    @Test
    @Tag("valid")
    public void testSizeReturnsZeroAfterRemovingAllElements() {
        LinkedList list = new LinkedList();
        list.add("first");
        list.add("second");
        list.remove("first");
        list.remove("second");
        assertEquals(0, (int) list.size());
    }
    @Test
    @Tag("invalid")
    public void testSizeRemainsUnchangedWhenRemovingNonExistentElement() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("two");
        list.remove("three");
        assertEquals(2, (int) list.size());
    }
    @Test
    @Tag("boundary")
    public void testSizeIncreasesWithDuplicateElements() {
        LinkedList list = new LinkedList();
        list.add("dup");
        list.add("dup");
        list.add("dup");
        assertEquals(3, (int) list.size());
    }
    @Test
    @Tag("integration")
    public void testSizeReflectsCorrectCountAfterMixedOperations() {
        LinkedList list = new LinkedList();
        list.add("A");
        list.add("B");
        list.add("C");
        list.remove("B");
        list.add("D");
        assertEquals(3, (int) list.size());
    }
    @Test
    @Tag("valid")
    public void testSizeUpdatesCorrectlyAfterHeadRemoval() {
        LinkedList list = new LinkedList();
        list.add("Head");
        list.add("Middle");
        list.add("Tail");
        list.remove("Head");
        assertEquals(2, (int) list.size());
    }
    @Test
    @Tag("boundary")
    public void testSizeHandlesLargeListAccurately() {
        LinkedList list = new LinkedList();
        int largeCount = 1000;
        for (int i = 0; i < largeCount; ++i) {
            list.add("item" + i);
        }
        assertEquals(largeCount, (int) list.size());
    }
    @Test
    @Tag("valid")
    public void testSizeDecreasesCorrectlyAfterConsecutiveRemovals() {
        LinkedList list = new LinkedList();
        list.add("one");
        list.add("two");
        list.add("three");
        list.remove("one");
        list.remove("three");
        assertEquals(1, (int) list.size());
    }
    @Test
    @Tag("integration")
    public void testSizeDoesNotAlterListState() {
        LinkedList list = new LinkedList();
        list.add("Alpha");
        list.add("Beta");
        list.add("Gamma");
        int before = (int) list.size();
        int middle = (int) list.size();
        int after = (int) list.size();
        assertEquals(3, before);
        assertEquals(3, middle);
        assertEquals(3, after);
    }
}
