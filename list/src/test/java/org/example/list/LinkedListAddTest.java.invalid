package org.example.list;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

class LinkedListAddTest {
    @Test
    @Tag("valid")
    public void testAddElementToEmptyList() {
        LinkedList list = new LinkedList();
        list.add("first");
        assertEquals(1, (int)list.size());
        assertEquals("first", (String)list.get(0));
    }
    @Test
    @Tag("valid")
    public void testAddElementToSingleNodeList() {
        LinkedList list = new LinkedList();
        list.add("first");
        list.add("second");
        assertEquals(2, (int)list.size());
        assertEquals("second", (String)list.get(1));
    }
    @Test
    @Tag("valid")
    public void testAddElementToMultipleNodeList() {
        LinkedList list = new LinkedList();
        list.add("a");
        list.add("b");
        list.add("c");
        list.add("d");
        assertEquals(4, (int)list.size());
        assertEquals("d", (String)list.get(3));
        assertEquals("a", (String)list.get(0));
        assertEquals("b", (String)list.get(1));
        assertEquals("c", (String)list.get(2));
    }
    @Test
    @Tag("invalid")
    public void testAddNullElement() {
        LinkedList list = new LinkedList();
        list.add(null);
        assertEquals(1, (int)list.size());
        assertNull((String)list.get(0));
    }
    @Test
    @Tag("valid")
    public void testAddDuplicateElements() {
        LinkedList list = new LinkedList();
        list.add("x");
        list.add("x");
        list.add("x");
        assertEquals(3, (int)list.size());
        assertEquals("x", (String)list.get(0));
        assertEquals("x", (String)list.get(1));
        assertEquals("x", (String)list.get(2));
    }
    @Test
