        LinkedList list = new LinkedList();
        int count = 100; // TODO: Change value for stress or size testing
        for (int i = 0; i < count; i++) {
            list.add("item" + i);
        }
        assertEquals(count, (int)list.size());
        for (int i = 0; i < count; i++) {
            assertEquals("item" + i, (String)list.get(i));
        }
    }
