package org.example.utilities;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.example.list.LinkedList;
import static org.junit.jupiter.api.Assertions.*;
import org.example.utilities.StringUtils;
import org.junit.jupiter.api.*;

public class StringUtilsSplitTest {
    @Test
    @Tag("invalid")
    public void testSplitWithNullInput() {
        String input = null;
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for null input"); // TODO: Adjust this assertion if business logic expects null instead
        assertEquals(0, ((LinkedList) result).size(), "Expected empty LinkedList for null input");
    }
    @Test
    @Tag("boundary")
    public void testSplitWithEmptyString() {
        String input = "";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for empty string input");
        // TODO: Change expected size to 1 if implementation returns a single empty entry
        assertEquals(0, ((LinkedList) result).size(), "Expected empty LinkedList for empty string input");
    }
    @Test
    @Tag("valid")
    public void testSplitWithCommaSeparatedValues() {
        String input = "a,b,c";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for valid input");
        assertEquals(3, ((LinkedList) result).size(), "Expected LinkedList size of 3");
        assertEquals("a", (String) result.get(0), "First element should be 'a'");
        assertEquals("b", (String) result.get(1), "Second element should be 'b'");
        assertEquals("c", (String) result.get(2), "Third element should be 'c'");
    }
    @Test
    @Tag("boundary")
    public void testSplitWithConsecutiveDelimiters() {
        String input = "a,,b,c";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for consecutive delimiters");
        // TODO: Adjust expected size if consecutive delimiters are merged
        assertEquals(4, ((LinkedList) result).size(), "Expected LinkedList size of 4 for 'a,,b,c'");
        assertEquals("a", (String) result.get(0), "First element should be 'a'");
        assertEquals("", (String) result.get(1), "Second element should be empty");
        assertEquals("b", (String) result.get(2), "Third element should be 'b'");
        assertEquals("c", (String) result.get(3), "Fourth element should be 'c'");
    }
    @Test
    @Tag("boundary")
    public void testSplitWithLeadingOrTrailingDelimiters() {
        String input = ",a,b,c,";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for input with leading/trailing delimiters");
        // TODO: Adjust assertion if implementation does not include empty elements at ends
        assertEquals(5, ((LinkedList) result).size(), "Expected LinkedList size of 5");
        assertEquals("", (String) result.get(0), "First element should be empty (leading delimiter)");
        assertEquals("a", (String) result.get(1), "Second element should be 'a'");
        assertEquals("b", (String) result.get(2), "Third element should be 'b'");
        assertEquals("c", (String) result.get(3), "Fourth element should be 'c'");
        assertEquals("", (String) result.get(4), "Fifth element should be empty (trailing delimiter)");
    }
    @Test
    @Tag("boundary")
    public void testSplitWithOnlyDelimiters() {
        String input = ",,,";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for string with only delimiters");
        // TODO: Adjust if business logic should ignore empty tokens
        assertEquals(4, ((LinkedList) result).size(), "Expected LinkedList size of 4 (all empty)");
        for (int i = 0; i < ((LinkedList) result).size(); i++) {
            assertEquals("", (String) result.get(i), "Element at index " + i + " should be empty string");
        }
    }
    @Test
    @Tag("valid")
    public void testSplitWithNoDelimiter() {
        String input = "abc";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for input with no delimiter");
        assertEquals(1, ((LinkedList) result).size(), "Expected LinkedList with a single element");
        assertEquals("abc", (String) result.get(0), "Single element should be 'abc'");
    }
    @Test
    @Tag("boundary")
    public void testSplitWithWhitespaceHandling() {
        String input = "a , b , c";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for string with whitespaces");
        assertEquals(3, ((LinkedList) result).size(), "Expected LinkedList size of 3");
        assertEquals("a ", (String) result.get(0), "First element should be 'a '");
        assertEquals(" b ", (String) result.get(1), "Second element should be ' b '");
        assertEquals(" c", (String) result.get(2), "Third element should be ' c'");
        // TODO: Adjust these assertions if whitespace should be trimmed in implementation
    }
    @Test
    @Tag("integration")
    public void testSplitWithLargeInputString() {
        StringBuilder sb = new StringBuilder();
        int entries = 10000; // TODO: Change to bigger or smaller value as per performance policy
        for (int i = 0; i < entries; i++) {
            sb.append("item").append(i);
            if (i < entries - 1) {
                sb.append(",");
            }
        }
        String input = sb.toString();
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for large input");
        assertEquals(entries, ((LinkedList) result).size(), "Expected LinkedList size to match number of entries");
        assertEquals("item0", (String) result.get(0), "First element should be 'item0'");
        assertEquals("item9999", (String) result.get(entries - 1), "Last element should be 'item9999'");
    }
    @Test
    @Tag("boundary")
    public void testSplitWithMixedDelimiters() {
        String input = "a,b;c|d";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for mixed delimiters");
        // TODO: Adjust assertions if logic supports splitting by multiple delimiters (business logic currently splits only on ',')
        assertEquals(2, ((LinkedList) result).size(), "Expected LinkedList size of 2 with only comma delimiter");
        assertEquals("a", (String) result.get(0), "First element should be 'a'");
        assertEquals("b;c|d", (String) result.get(1), "Second element should be 'b;c|d'");
    }
    @Test
    @Tag("valid")
    public void testSplitReturnTypeValidation() {
        String input = "foo,bar";
        LinkedList result = StringUtils.split(input);
        assertTrue(((Object) result) instanceof LinkedList, "Returned object should be of type LinkedList");
    }
    @Test
    @Tag("valid")
    public void testSplitWithUnicodeAndSpecialCharacters() {
        String input = "ümlaut,emoji😊,ç";
        LinkedList result = StringUtils.split(input);
        assertNotNull((Object) result, "Result should not be null for Unicode and special characters");
        assertEquals(3, ((LinkedList) result).size(), "Expected LinkedList size of 3");
        assertEquals("ümlaut", (String) result.get(0), "First element should be 'ümlaut'");
        assertEquals("emoji😊", (String) result.get(1), "Second element should be 'emoji😊'");
        assertEquals("ç", (String) result.get(2), "Third element should be 'ç'");
    }
