package org.example.utilities;
import org.example.list.LinkedList;
import org.example.utilities.StringUtils;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Tag;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.*;

public class StringUtilsSplitTest {
    @Test
    @Tag("valid")
    public void testSplitSimpleCommaSeparatedString() {
        String source = "apple,banana,orange";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(3, result.size());
        assertEquals((String) "apple", (String) result.get(0));
        assertEquals((String) "banana", (String) result.get(1));
        assertEquals((String) "orange", (String) result.get(2));
    }
    @Test
    @Tag("valid")
    public void testSplitStringWithConsecutiveDelimiters() {
        String source = "apple,,orange";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(3, result.size());
        assertEquals((String) "apple", (String) result.get(0));
        assertEquals((String) "", (String) result.get(1));
        assertEquals((String) "orange", (String) result.get(2));
    }
    @Test
    @Tag("boundary")
    public void testSplitEmptyString() {
        String source = "";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertTrue(result.size() == 0 || (result.size() == 1 && "".equals((String)result.get(0))));
    }
    @Test
    @Tag("invalid")
    public void testSplitNullString() {
        String source = null;
        try {
            LinkedList result = (LinkedList) StringUtils.split(source);
            assertNotNull((Object)result); // If implementation returns empty list for null.
        } catch (NullPointerException | IllegalArgumentException e) {
            assertTrue(e instanceof NullPointerException || e instanceof IllegalArgumentException);
        }
        // Note: Business logic should decide if null input returns empty LinkedList or throws an exception.
        // If only NullPointerException is thrown for null input, business logic should be enhanced to allow null as valid input and return an empty list.
    }
    @Test
    @Tag("valid")
    public void testSplitStringWithNoDelimiters() {
        String source = "grape";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(1, result.size());
        assertEquals((String) "grape", (String) result.get(0));
    }
    @Test
    @Tag("boundary")
    public void testSplitStringContainingOnlyDelimiters() {
        String source = ",,,";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(4, result.size());
        assertEquals((String) "", (String) result.get(0));
        assertEquals((String) "", (String) result.get(1));
        assertEquals((String) "", (String) result.get(2));
        assertEquals((String) "", (String) result.get(3));
    }
    @Test
    @Tag("boundary")
    public void testSplitStringWithLeadingAndTrailingDelimiters() {
        String source = ",apple,banana,";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(4, result.size());
        assertEquals((String) "", (String) result.get(0));
        assertEquals((String) "apple", (String) result.get(1));
        assertEquals((String) "banana", (String) result.get(2));
        assertEquals((String) "", (String) result.get(3));
    }
    @Test
    @Tag("valid")
    public void testSplitStringWithWhitespaceAroundDelimiters() {
        String source = "pear , peach ,plum";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(3, result.size());
        assertEquals((String) "pear ", (String) result.get(0));
        assertEquals((String) " peach ", (String) result.get(1));
        assertEquals((String) "plum", (String) result.get(2));
    }
    @Test
    @Tag("valid")
    public void testSplitLongStringWithManyDelimiters() {
        String source = "a,b,c,d,e,f,g,h,i,j";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(10, result.size());
        assertEquals((String) "a", (String) result.get(0));
        assertEquals((String) "j", (String) result.get(9));
    }
    @Test
    @Tag("boundary")
    public void testSplitStringWithSpecialCharacters() {
        String source = "hi@home#safe\tend";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(1, result.size());
        assertEquals((String) "hi@home#safe\tend", (String) result.get(0));
    }
    @Test
    @Tag("boundary")
    public void testSplitStringWithMultipleWhitespaces() {
        String source = "cat, ,dog,  ,parrot";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(5, result.size());
        assertEquals((String) "cat", (String) result.get(0));
        assertEquals((String) " ", (String) result.get(1));
        assertEquals((String) "dog", (String) result.get(2));
        assertEquals((String) "  ", (String) result.get(3));
        assertEquals((String) "parrot", (String) result.get(4));
    }
    @Test
    @Tag("integration")
    public void testSplitVeryLargeString() {
        int repeatCount = 10000;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < repeatCount; i++) {
            sb.append("entry,");
        }
        String source = sb.toString();
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(repeatCount + 1, result.size());
        for (int i = 0; i < repeatCount; i++) {
            assertEquals((String) "entry", (String) result.get(i));
        }
        assertEquals((String) "", (String) result.get(repeatCount));
    }
    @Test
    @Tag("valid")
    public void testSplitUnicodeString() {
        String source = "猫,狗,鸟";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals(3, result.size());
        assertEquals((String) "猫", (String) result.get(0));
        assertEquals((String) "狗", (String) result.get(1));
        assertEquals((String) "鸟", (String) result.get(2));
    }
    @Test
    @Tag("valid")
    public void testSplitImmutableString() {
        final String source = "static,immutable,value";
        String sourceBefore = new String(source);
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        assertEquals((String) sourceBefore, (String) source); // Checks immutability of input
        assertEquals(3, result.size());
        assertEquals((String) "static", (String) result.get(0));
        assertEquals((String) "immutable", (String) result.get(1));
        assertEquals((String) "value", (String) result.get(2));
    }
    @Test
    @Tag("boundary")
    public void testSplitStringWithMixedLineEndings() {
        String source = "row1,row2\nrow3,row4\rrow5";
        LinkedList result = (LinkedList) StringUtils.split(source);
        assertNotNull((Object)result);
        // Only splits at comma, others remain part of token
        assertEquals(3, result.size());
        assertEquals((String) "row1", (String) result.get(0));
        assertEquals((String) "row2\nrow3", (String) result.get(1));
        assertEquals((String) "row4\rrow5", (String) result.get(2));
    }
}