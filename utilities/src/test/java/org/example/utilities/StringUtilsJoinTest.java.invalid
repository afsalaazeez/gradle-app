package org.example.utilities;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import static org.junit.jupiter.api.Assertions.*;

public class StringUtilsJoinTest {
    @Test
    @Tag("valid")
    public void testJoinMultipleStrings() {
        LinkedList list = new LinkedList();
        list.add("apple");
        list.add("banana");
        list.add("cherry");
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
    }
    @Test
    @Tag("valid")
    public void testJoinSingleString() {
        LinkedList list = new LinkedList();
        list.add("single");
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
    }
    @Test
    @Tag("boundary")
    public void testJoinEmptyList() {
        LinkedList list = new LinkedList();
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
    }
    @Test
    @Tag("boundary")
    public void testJoinListWithNullElements() {
        LinkedList list = new LinkedList();
        list.add("dog");
        list.add(null);
        list.add("cat");
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
    }
    @Test
    @Tag("boundary")
    public void testJoinListWithEmptyStrings() {
        LinkedList list = new LinkedList();
        list.add("");
        list.add("");
        list.add("");
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
    }
    @Test
    @Tag("invalid")
    public void testJoinListWithNonStringElements() {
        LinkedList list = new LinkedList();
        list.add("apple");
        list.add((Object) 123); // Added proper Object casting
        list.add((Object) new DummyObject("dummy")); // Dummy object for testing
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
    }
    static class DummyObject {
        private final String value;
        DummyObject(String value) {
            this.value = value;
        }
        @Override
        public String toString() {
            return value;
        }
    }
    @Test
    @Tag("invalid")
    public void testJoinNullListReference() {
        LinkedList list = null;
        // Suggestion for business logic improvement:
        // StringUtils.join should gracefully handle null list references (return empty string or handle as per requirements)
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
    }
    @Test
    @Tag("boundary")
    public void testJoinListWithLongStringElement() {
        StringBuilder longStr = new StringBuilder();
        for (int i = 0; i < 10000; i++) {
            longStr.append("a");
        }
        LinkedList list = new LinkedList();
        list.add(longStr.toString());
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
        assertNotNull((String) StringUtils.join(list));
        assertEquals(10000, ((String) StringUtils.join(list)).length());
    }
    @Test
    @Tag("integration")
    public void testJoinListWithSpecialCharacters() {
        LinkedList list = new LinkedList();
        list.add("hello");
        list.add("😊");
        list.add("世界");
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
        assertTrue(((String) StringUtils.join(list)).contains("😊"));
        assertTrue(((String) StringUtils.join(list)).contains("世界"));
    }
    @Test
    @Tag("boundary")
    public void testJoinListWithDelimiterInsideElements() {
        LinkedList list = new LinkedList();
        list.add("a,b");
        list.add("c");
        list.add("d");
        String expected = (String) JoinUtils.join(list);
        assertEquals(expected, (String) StringUtils.join(list));
        assertTrue(((String) StringUtils.join(list)).contains("a,b"));
    }
}