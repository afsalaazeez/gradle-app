    @Test
    @Tag("valid")
    @DisplayName("Join a LinkedList with Very Long String Elements")
    public void joinLinkedListWithVeryLongStrings() {
        // Arrange
        LinkedList source = new LinkedList();
        StringBuilder longString = new StringBuilder();
        for (int i = 0; i < 1000; i++) {
            longString.append("LongText");
        }
        source.add(longString.toString());
        source.add("Short");
        source.add(longString.toString());
        
        // Act
        String result = StringUtils.join(source);
        
        // Assert
        assertNotNull(result, "Result should not be null");
        assertTrue(result.contains("LongText"), "Result should contain long text");
        assertTrue(result.contains("Short"), "Result should contain short text");
        assertTrue(result.length() > 1000, "Result should be appropriately long");
    }
