package org.example.utilities;
import org.example.list.LinkedList;
import org.junit.jupiter.api.Tag;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.DisplayName;
import static org.junit.jupiter.api.Assertions.*;

public class StringUtilsJoinTest {
    
    @Test
    @Tag("boundary")
    @DisplayName("Join an Empty LinkedList")
    public void joinEmptyLinkedList() {
        // Arrange
        LinkedList source = new LinkedList();
        
        // Act
        String result = StringUtils.join(source);
        
        // Assert
        assertTrue(result == null || result.isEmpty(), 
            "Joining an empty LinkedList should return null or empty string");
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Join a LinkedList with a Single Element")
    public void joinLinkedListWithSingleElement() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("Hello");
        
        // Act
        String result = StringUtils.join(source);
        
        // Assert
        assertNotNull(result, "Result should not be null");
        assertTrue(result.contains("Hello"), 
            "Result should contain the single element");
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Join a LinkedList with Multiple Elements")
    public void joinLinkedListWithMultipleElements() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("Apple");
        source.add("Banana");
        source.add("Cherry");
        
        // Act
        String result = StringUtils.join(source);
        
        // Assert
        assertNotNull(result, "Result should not be null");
        assertTrue(result.contains("Apple"), "Result should contain Apple");
        assertTrue(result.contains("Banana"), "Result should contain Banana");
        assertTrue(result.contains("Cherry"), "Result should contain Cherry");
    }
    
    @Test
    @Tag("invalid")
    @DisplayName("Join a LinkedList with Null Reference")
