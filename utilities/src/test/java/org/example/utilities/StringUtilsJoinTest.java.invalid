    @Test
    @Tag("valid")
    @DisplayName("Join a Large LinkedList")
    public void joinLargeLinkedList() {
        // Arrange
        LinkedList source = new LinkedList();
        int elementCount = 10000;
        for (int i = 0; i < elementCount; i++) {
            source.add("Element" + i);
        }
        
        // Act
        long startTime = System.currentTimeMillis();
        String result = StringUtils.join(source);
        long endTime = System.currentTimeMillis();
        
        // Assert
        assertNotNull(result, "Result should not be null");
        assertTrue(result.contains("Element0"), "Result should contain first element");
        assertTrue(result.contains("Element" + (elementCount - 1)), 
            "Result should contain last element");
        assertTrue((endTime - startTime) < 5000, 
            "Operation should complete within reasonable time (5 seconds)");
    }
    
    @Test
