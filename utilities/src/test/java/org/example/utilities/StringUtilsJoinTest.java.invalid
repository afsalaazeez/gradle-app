        // Arrange
        LinkedList source = null;
        
        // Act & Assert
        assertThrows(NullPointerException.class, () -> {
            StringUtils.join(source);
        }, "Joining a null LinkedList should throw NullPointerException");
    }
    
    @Test
    @Tag("valid")
    @DisplayName("Join a LinkedList with Elements Containing Special Characters")
    public void joinLinkedListWithSpecialCharacters() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("Hello, World");
        source.add("Test;Data");
        source.add("Quote\"Test");
        source.add("New\nLine");
        source.add("Tab\tChar");
        
        // Act
        String result = StringUtils.join(source);
        
        // Assert
        assertNotNull(result, "Result should not be null");
        assertTrue(result.contains("Hello, World") || result.contains(","), 
            "Result should preserve comma character");
        assertTrue(result.contains("Test;Data") || result.contains(";"), 
            "Result should preserve semicolon character");
        assertTrue(result.contains("Quote\"Test") || result.contains("\""), 
            "Result should preserve quote character");
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Join a LinkedList Containing Null Elements")
    public void joinLinkedListContainingNullElements() {
        // Arrange
        LinkedList source = new LinkedList();
        source.add("First");
        source.add(null);
        source.add("Third");
        source.add(null);
        
        // Act
        String result = StringUtils.join(source);
        
        // Assert
        assertNotNull(result, "Result should not be null even with null elements");
        assertTrue(result.contains("First"), "Result should contain First");
        assertTrue(result.contains("Third"), "Result should contain Third");
    }
    
    @Test
    @Tag("boundary")
    @DisplayName("Join a LinkedList with Empty String Elements")
